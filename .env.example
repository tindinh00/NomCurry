# Google Service Account credentials (from GCP Console > IAM > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID (from the sheet URL)
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"

# Dev only: actor email for local testing (remove in production)
NOMCURRY_DEV_ACTOR_EMAIL="manager@example.com"

# NextAuth settings (for Google OAuth)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
AUTH_SECRET="your-random-32-character-secret-key"
